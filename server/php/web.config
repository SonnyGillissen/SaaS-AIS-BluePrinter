<?xml version="1.0" encoding="utf-8"?>
<!-- AIS BluePrinter - protect server-side files on IIS / Azure App Service (Windows). -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.sample.php" />
          <add segment="lib.php" />
          <add segment="setup-cli.php" />
          <add segment="install.lock" />
          <add segment="schema" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
