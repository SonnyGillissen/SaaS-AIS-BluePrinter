# Copy to .env (next to the compose files) or let install.sh / install.ps1 generate it.
# Database password (MySQL user password, or SQL Server SA password: 8+ chars, upper, lower, digit, symbol)
AISBP_DB_PASSWORD=Change-me-Str0ng!
# MySQL root password (MySQL setup only)
AISBP_DB_ROOT_PASSWORD=Change-me-R00t!
# Optional shared API key (letters, digits, - and _); leave empty to disable
AISBP_API_KEY=
# Host port
AISBP_PORT=8080
